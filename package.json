{
  "name": "kaede",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "KAEDE — Trello Power-Up, MCP Server & CLI Orchestrator for AI Agent ecosystem",
  "type": "module",
  "scripts": {
    "dev": "bun run build:mcp && bun run dev:static",
    "dev:static": "bun run --filter @kaede/static dev",
    "dev:webui": "bun run --filter @kaede/webui dev",
    "dev:docs": "bun run --filter @kaede/docs preview",
    "build": "bun run build:static",
    "build:static": "bun run --filter @kaede/static build",
    "build:webui": "bun run --filter @kaede/webui build",
    "build:mcp": "bun scripts/build-mcp.ts",
    "build:cli": "bun build --compile scripts/kaede.ts --outfile dist/release/bin/kaede",
    "build:release": "bun scripts/build-release.ts",
    "build:release:upload": "bun scripts/build-release.ts --upload",
    "build:docs": "bun run build:static && bun run --filter @kaede/docs build",
    "serve": "bun x serve . -p 3000 -L",
    "preview": "bun run build && bun x serve apps/static/dist -p 3000 -L",
    "deploy:netlify": "netlify deploy --prod --dir=apps/static/dist",
    "deploy:netlify:preview": "netlify deploy --dir=apps/static/dist",
    "deploy:gh-pages": "bun run --filter @kaede/docs deploy",
    "kaede": "bun scripts/kaede.ts",
    "kaede:setup": "bun scripts/kaede.ts setup",
    "kaede:today": "bun scripts/kaede.ts today",
    "kaede:status": "bun scripts/kaede.ts status",
    "kaede:env": "bun scripts/kaede.ts env",
    "test": "bun scripts/run-tests.ts",
    "test:orchestrator": "bun test packages/kaede/test/orchestrator.test.js",
    "test:trello": "bun test packages/kaede/test/trello-client.test.js",
    "test:e2e": "bun test packages/kaede/test/e2e-orchestrator.test.js",
    "test:mcp": "bun test packages/kaede/test/mcp-server.test.js",
    "test:all": "bun scripts/run-tests.ts"
  },
  "bin": {
    "kaede": "./scripts/kaede.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "@types/bun": "^1.3.14",
    "concurrently": "^10.0.3",
    "netlify-cli": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "marked": "^18.0.5"
  }
}
