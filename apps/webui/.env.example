# Turso DB Configuration
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Auth.js / NextAuth Configuration
AUTH_SECRET=your-random-32-byte-secret-key
AUTH_GITHUB_ID=your-github-oauth-app-client-id
AUTH_GITHUB_SECRET=your-github-oauth-app-client-secret

# GitHub App repository access (separate from GitHub OAuth sign-in)
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional local codebase-memory-mcp executable override
# CODEBASE_MEMORY_MCP_PATH=codebase-memory-mcp
